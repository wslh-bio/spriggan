nextflow_process {

    name "Test Process REJECTED_SAMPLES"
    script "modules/local/rejected_samples/rejected_samples.nf"
    process "REJECTED_SAMPLES"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/rejected_samples/tests/data"
                """
                input[0] = file("${data_dir}" + "/empty_samples.csv")
                input[1] = "Spriggan"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                     },
                { assert snapshot(process.out).match()                                                       },
                { assert file(process.out.rejected_samples_report[0]).name.split("/")[-1] == 'Spriggan_empty_samples.csv' }
            )
        }
    }

    test("stub test for rejected_samples.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/rejected_samples/tests/data"
                """
                input[0] = file("${data_dir}" + "/empty_samples.csv")
                input[1] = "Spriggan"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                     },
                { assert snapshot(process.out).match()                                                       },
                { assert file(process.out.rejected_samples_report[0]).name.split("/")[-1] == 'Spriggan_empty_samples.csv' }
            )
        }
    }
}
