nextflow_process {

    name "Test Process MLST"
    script "modules/local/mlst/mlst.nf"
    process "MLST"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/mlst/tests/data/"
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                file("${data_dir}" + 'Sample01.contigs.fa')]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }
            )
        }
    }

    test("stub test for mlst.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/mlst/tests/data/"
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                file("${data_dir}" + 'Sample01.contigs.fa')]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }
            )
        }
    }
}
