nextflow_process {

    name "Test Process KRAKEN"
    script "modules/local/kraken/kraken.nf"
    process "KRAKEN"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                       },
                { assert snapshot(process.out).match()                                                         },
                { assert file(process.out.kraken_results[0][1]).name.split("/")[-1] ==~ 'Sample01.kraken2.txt' },
                { assert file(process.out.log[0]).name.split("/")[-1] ==~ 'kraken2.log'                        },
                { assert file(process.out.versions[0]).name.split("/")[-1] ==~ 'versions.yml'                  }
            )
        }
    }

    test("stub test for kraken2.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                input[1] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                       },
                { assert snapshot(process.out).match()                                                         },
                { assert file(process.out.kraken_results[0][1]).name.split("/")[-1] ==~ 'Sample01.kraken2.txt' },
                { assert file(process.out.log[0]).name.split("/")[-1] ==~ 'kraken2.log'                        },
                { assert file(process.out.versions[0]).name.split("/")[-1] ==~ 'versions.yml'                  }
            )
        }
    }
}
