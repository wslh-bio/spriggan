nextflow_process {

    name "Test Process ASSEMBLY_STATS_SUMMARY"
    script "modules/local/assembly_stats_summary/assembly_stats_summary.nf"
    process "ASSEMBLY_STATS_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/assembly_stats_summary/tests/data/"
                """
                input[0] = [
                    file("${data_dir}/Sample01_Assembly_ratio_20240124.txt"),
                    file("${data_dir}/Sample02_Assembly_ratio_20240124.txt")
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success               },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub test for assembly_stats_summary.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/assembly_stats_summary/tests/data/"
                """
                input[0] = [
                    file("${data_dir}/Sample01_Assembly_ratio_20240124.txt"),
                    file("${data_dir}/Sample02_Assembly_ratio_20240124.txt")
                    ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success               },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
