nextflow_process {

    name "Test Process COVERAGE_STATS"
    script "modules/local/coverage_stats/coverage_stats.nf"
    process "COVERAGE_STATS"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/coverage_stats/tests/data"
                """
                input[0] = [ file("${data_dir}/SAMPLE1_PE.depth.tsv"),
                           file("${data_dir}/SAMPLE2_PE.depth.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub test for coverage_stats.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/coverage_stats/tests/data"
                """
                input[0] = [ file("${data_dir}/SAMPLE1_PE.depth.tsv"),
                           file("${data_dir}/SAMPLE2_PE.depth.tsv") ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
