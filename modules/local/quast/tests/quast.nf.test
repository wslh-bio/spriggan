nextflow_process {

    name "Test Process QUAST"
    script "modules/local/quast/quast.nf"
    process "QUAST"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/quast/tests/data/"
                """
                input[0] = [
                [id:'SPN_Sample_01', single_end:false ],
                [ file("${data_dir}" + 'SPN_Sample_01.contigs.fa') ]
                ]
                input[1] = "500"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                                            },
                { assert snapshot(process.out).match()                                                                              },
                { assert file(process.out.transposed_report[0][1]).name.split("/")[-1] ==~ "SPN_Sample_01.transposed.quast.report.tsv" },
                { assert file(process.out.result[0][1]).name.split("/")[-1] ==~ "SPN_Sample_01.quast.report.tsv"                       }
            )
        }
    }

    test("Stub test for quast.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'SPN_Sample_01', single_end:false ],
                [ file("${baseDir}" + '/modules/local/quast/tests/SPN_Sample_01.contigs.fa') ]
                ]
                input[1] = "500"
                """
            }
        }

        then {
            assertAll (
                { assert process.success                                                                                            },
                { assert snapshot(process.out).match()                                                                              },
                { assert file(process.out.transposed_report[0][1]).name.split("/")[-1] ==~ "SPN_Sample_01.transposed.quast.report.tsv" },
                { assert file(process.out.result[0][1]).name.split("/")[-1] ==~ "SPN_Sample_01.quast.report.tsv"                       }
            )
        }
    }
}
