nextflow_process {

    name "Test Process SAMTOOLS"
    script "modules/local/samtools/samtools.nf"
    process "SAMTOOLS"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/samtools/tests/data"
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                [ file("${data_dir}" + '/Sample01.sam') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }            )
        }
    }

    test("stub test for samtools.nf") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/samtools/tests/data"
                """
                input[0] = [
                [id:'Sample01', single_end:false ],
                [ file("${data_dir}" + '/Sample01.sam') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
