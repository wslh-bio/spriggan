nextflow_process {

    name "Test Process AMRFINDER_SUMMARY"
    script "modules/local/amrfinder_summary/amrfinder_summary.nf"
    process "AMRFINDER_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/amrfinder_summary/tests/data/"
                """
                input[0] = [
                    file("${data_dir}/Sample01.amr.tsv"),
                    file("${data_dir}/Sample02.amr.tsv")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub run without failures") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/amrfinder_summary/tests/data/"
                """
                input[0] = [
                    file("${data_dir}/Sample01.amr.tsv"),
                    file("${data_dir}/Sample02.amr.tsv")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success }
                { assert snapshot(process.out).match() }
            )
        }
    }
}
