nextflow_process {

    name "Test Process SHOVILL"
    script "modules/local/shovill/shovill.nf"
    process "SHOVILL"
    tag "modules"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [id:'Sample01', single_end:false ],
                        [file("${baseDir}/test-dataset/Sample01_R1.fastq.gz"), file("${baseDir}/test-dataset/Sample01_R2.fastq.gz")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                            },
                { assert process.out.raw_contigs.size() == 1                        },
                { assert file(process.out.raw_contigs[0][1]).text.contains(">")     },
                { assert file(process.out.raw_contigs[0][1]).text.contains("NODE")  },
                { assert file(process.out.raw_contigs[0][1]).text.contains("pilon") },
                { assert file(process.out.raw_contigs[0][1]).name == "spades.fasta" }
            )
        }
    }

    test("stub test for shovill.nf") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                // define inputs of the process here. Example:
                input[0] = [
                    [id:'Sample01', single_end:false ],
                        [file("${baseDir}/test-dataset/Sample01_R1.fastq.gz"), file("${baseDir}/test-dataset/Sample01_R2.fastq.gz")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
