nextflow_process {

    name "Test Process COUNT_FASTQ"
    script "modules/local/count_fastq/count_fastq.nf"
    process "COUNT_FASTQ"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("stub test for count_fastq.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success               },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
