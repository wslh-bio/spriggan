nextflow_process {

    name "Test Process AMRFINDER"
    script "modules/local/amrfinder/amrfinder.nf"
    process "AMRFINDER"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'Sample01'],
                [ file("${baseDir}" + '/modules/local/amrfinder/tests/data/Sample01.Acinetobacter_baumannii.fa') ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot( process.out ).match()
                }
            )
        }
    }

    test("stub test for amrfinder") {

        options "-stub"

        when {
            params {
                outdir = "tests/results"
            }
            process {
                """
                input[0] = [
                [id:'SAMPLE2'],
                [ file("${baseDir}" + '/modules/local/amrfinder/tests/data/SAMPLE1_PE.NA.fa') ]
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
