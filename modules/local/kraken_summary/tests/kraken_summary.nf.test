nextflow_process {

    name "Test Process KRAKEN_SUMMARY"
    script "modules/local/kraken_summary/kraken_summary.nf"
    process "KRAKEN_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/kraken_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + '/Sample01.kraken2.txt'),
                file("${data_dir}" + '/Sample02.kraken2.txt')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                             },
                { assert snapshot(process.out).match()                                               },
                { assert file(process.out.kraken_tsv[0]).name.split("/")[-1] == 'kraken_results.tsv' }
            )
        }
    }

    test("stub test for kraken_summary.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/kraken_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + '/Sample01.kraken2.txt'),
                file("${data_dir}" + '/Sample02.kraken2.txt')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                             },
                { assert snapshot(process.out).match()                                               },
                { assert file(process.out.kraken_tsv[0]).name.split("/")[-1] == 'kraken_results.tsv' }
            )
        }
    }
}
