nextflow_process {

    name "Test Process REPORT"
    script "modules/local/report/report.nf"
    config "./nextflow.config"
    process "REPORT"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/report/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + "/test-file.txt"),
                file("${data_dir}" + "/amrfinder_summary.tsv"),
                file("${data_dir}" + "/bbduk_results.tsv"),
                file("${data_dir}" + "/db_versions.yml"),
                file("${data_dir}" + "/kraken_results.tsv"),
                file("${data_dir}" + "/NTC01.kraken2.txt"),
                file("${data_dir}" + "/selected_ar_genes.tsv"),
                file("${data_dir}" + "/assembly_stats_results.tsv"),
                file("${data_dir}" + "/coverage_stats.tsv"),
                file("${data_dir}" + "/gc_stats_results.tsv"),
                file("${data_dir}" + "/mlst_results.tsv"),
                file("${data_dir}" + "/quast_results.tsv")
                ]
                input[1] = ""
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                        },
                { assert snapshot(process.out).match()                                                          },
                { assert file(process.out.result_csv[0]).name.split("/")[-1] == 'test_full_spriggan_report.csv' },
                { assert file(process.out.result_csv[0]).text.contains("Sample01,test_full")                    }
            )
        }
    }

    test("stub test for report.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/report/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + "/test-file.txt"),
                file("${data_dir}" + "/amrfinder_summary.tsv"),
                file("${data_dir}" + "/bbduk_results.tsv"),
                file("${data_dir}" + "/db_versions.yml"),
                file("${data_dir}" + "/kraken_results.tsv"),
                file("${data_dir}" + "/NTC01.kraken2.txt"),
                file("${data_dir}" + "/selected_ar_genes.tsv"),
                file("${data_dir}" + "/assembly_stats_results.tsv"),
                file("${data_dir}" + "/coverage_stats.tsv"),
                file("${data_dir}" + "/gc_stats_results.tsv"),
                file("${data_dir}" + "/mlst_results.tsv"),
                file("${data_dir}" + "/quast_results.tsv")
                ]
                input[1] = ""
                """
            }
        }

        then {
            assertAll(
                { assert process.success                                                                        },
                { assert snapshot(process.out).match()                                                          },
                { assert file(process.out.result_csv[0]).name.split("/")[-1] == 'test_full_spriggan_report.csv' }
            )
        }
    }
}
