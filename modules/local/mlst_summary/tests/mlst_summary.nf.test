nextflow_process {

    name "Test Process MLST_SUMMARY"
    script "modules/local/mlst_summary/mlst_summary.nf"
    process "MLST_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/mlst_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + 'Sample01.mlst.tsv'),
                file("${data_dir}" + 'Sample02.mlst.tsv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }
            )
        }
    }

    test("stub test for mlst_summary.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/mlst_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + 'Sample01.mlst.tsv'),
                file("${data_dir}" + 'Sample02.mlst.tsv')
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }
            )
        }
    }
}
