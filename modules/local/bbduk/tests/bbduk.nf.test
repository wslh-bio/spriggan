nextflow_process {

    name "Test Process BBDUK"
    script "../bbduk.nf"
    process "BBDUK"
    tag "module"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                input[1] = file("${baseDir}" + "/modules/local/bbduk/tests/data/adapters.fa")
                """
            }
        }

        then {
            assertAll(
                { assert process.success        },
                { assert snapshot(process.out)  }
            )
        }
    }

    test("sample01 - paired end fastq") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/Sample01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/Sample01_R2.fastq.gz') ]
                ]
                input[1] = file("${baseDir}" + "/modules/local/bbduk/tests/data/adapters.fa")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.log[0][1]).getText().contains("Input is being processed as paired")},
                { assert snapshot(process.out.versions).match() }

            )
        }
    }

    test('stub test for bbduk') {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }

            process {
                """
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${baseDir}" + '/test-dataset/SPN_Sample_01_R1.fastq.gz'),
                file("${baseDir}" + '/test-dataset/SPN_Sample_01_R2.fastq.gz') ]
                ]
                input[1] = file("${baseDir}" + "/modules/local/bbduk/tests/data/adapters.fa")
                """
            }
        }

        then {
            assertAll (
                { assert process.success        },
                { assert snapshot(process.out)  }
            )
        }
    }
}
