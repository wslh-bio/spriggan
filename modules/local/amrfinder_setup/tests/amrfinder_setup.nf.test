nextflow_process {

    name "Test Process AMRFINDER_SETUP"
    script "modules/local/amrfinder_setup/amrfinder_setup.nf"
    process "AMRFINDER_SETUP"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/amrfinder_setup/tests/data/"
                """
                // define inputs of the process here. Example:
                input[0] = file("${data_dir}" + "kraken_results.tsv")
                input[1] = [
                [ id: 'Sample01', single_end:false ],
                [ file("${data_dir}" + "Sample01.contigs.fa") ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("-stub test for amrfinder_setup.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/amrfinder_setup/tests/data/"
                """
                // define inputs of the process here. Example:
                input[0] = file("${data_dir}" + "kraken_results.tsv")
                input[1] = [
                [ id: 'Sample01', single_end:false ],
                [ file("${data_dir}" + "Sample01.contigs.fa") ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
