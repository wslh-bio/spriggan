nextflow_process {

    name "Test Process GC_STATS_SUMMARY"
    script "modules/local/gc_stats_summary/gc_stats_summary.nf"
    process "GC_STATS_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/gc_stats_summary/tests/data/"
                """
                input[0] = [
                file("${data_dir}" + 'Sample01_GC_content_20240124.txt'),
                file("${data_dir}" + 'Sample02_GC_content_20240124.txt')
                ]
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
