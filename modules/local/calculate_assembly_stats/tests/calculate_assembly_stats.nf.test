nextflow_process {

    name "Test Process CALCULATE_ASSEMBLY_STATS"
    script "modules/local/calculate_assembly_stats/calculate_assembly_stats.nf"
    process "CALCULATE_ASSEMBLY_STATS"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/calculate_assembly_stats/tests/data/"
                """
                // define inputs of the process here. Example:
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${data_dir}" + 'SAMPLE1_PE.transposed.quast.report.tsv') ],
                [ file("${data_dir}" + 'SAMPLE1_PE.kraken2.txt') ]
                ]
                input[1] = "${baseDir}/assets/databases/NCBI_Assembly_stats_20240124.txt"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }

            )
        }
    }

    test("stub test for calculate assembly stats") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                def data_dir = "${baseDir}/modules/local/calculate_assembly_stats/tests/data/"
                """
                // define inputs of the process here. Example:
                input[0] = [
                [id:'test', single_end:false ],
                [ file("${data_dir}" + 'SAMPLE1_PE.transposed.quast.report.tsv') ],
                [ file("${data_dir}" + 'SAMPLE1_PE.kraken2.txt') ]
                ]
                input[1] = "${baseDir}/assets/databases/NCBI_Assembly_stats_20240124.txt"
                """
            }
        }

        then {
            assertAll(
                { assert process.success                },
                { assert snapshot(process.out).match()  }

            )
        }
    }
}
