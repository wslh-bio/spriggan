nextflow_process {

    name "Test Process BBDUK_SUMMARY"
    script "modules/local/bbduk_summary/bbduk_summary.nf"
    process "BBDUK_SUMMARY"

    test("Should run without failures") {

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = file("${baseDir}" + "/modules/local/bbduk_summary/tests/data/*")
                """
            }
        }

        then {
            assertAll(
                { assert process.success          },
                { assert snapshot(process.out)    }
            )
        }
    }

    test("stub test for bbduk_summary.nf") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = file("${baseDir}" + "/modules/local/bbduk_summary/tests/data*/*")
                """
            }
        }

        then {
            assertAll(
                { assert process.success          },
                { assert snapshot(process.out)    }
            )
        }
    }
}
